# Server port and environment
PORT=3000
NODE_ENV="development"

# Gemini API Key (optional, for Gemini AI explanations and OCR)
GEMINI_API_KEY=""

# Public application URL
APP_URL="http://localhost:3000"

# SQLite database file path (defaults to ./data/guardian.db)
GUARDIAN_DB_PATH="./data/guardian.db"

# Seed default demo accounts (ramesh_parent & ananya_guardian with password "GuardianPreview!2026")
ENABLE_DEMO_ACCOUNTS="true"

# CORS Allowed Origins (comma-separated, or "*" for any)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost"

# Frontend API base URL (leave empty when backend and frontend are hosted together, or set when hosted separately e.g. Vercel frontend + Render backend)
VITE_API_BASE_URL=""
VITE_APP_ENV="development"
