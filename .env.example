# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite database file path (optional, defaults to ./data/guardian.db)
GUARDIAN_DB_PATH="./data/guardian.db"

# Enable demo accounts seeding in local development ("false" in production)
ENABLE_DEMO_ACCOUNTS="false"
